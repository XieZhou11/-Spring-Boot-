{
  "name": "handcraft-platform-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "axios": "1.21.1",
    "element-plus": "2.14.8",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "mysql2": "3.24.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "npm@11.19.1"
}
